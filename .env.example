DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional: S3-backed media uploads. If unset, uploads fall back to local
# disk (fine for dev, NOT fine on Vercel — its filesystem is ephemeral).
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY

# Frontend origin(s) allowed to call the CMS API — matched against
# NEXT_PUBLIC_CMS_URL on the tulas_rev side. Only needed beyond the default
# localhost dev ports (see payload.config.ts).
FRONTEND_URL=https://your-tulas-rev-domain.vercel.app
